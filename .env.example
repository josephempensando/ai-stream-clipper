# Local Story Narrator voices (see README for model downloads and registry setup).
# Presets: en_US-lessac-medium (Woman), en_US-ryan-medium (Man),
# en_US-lessac-childlike (pitch-adjusted synthetic style, reuses Lessac).
PIPER_PYTHON=.venv/Scripts/python.exe
PIPER_VOICES_DIR=./data/piper-voices
PIPER_DEFAULT_VOICE=en_US-lessac-medium
PIPER_TIMEOUT_MS=180000
STORY_MAX_SCRIPT_CHARS=30000
STORY_TTS_CHUNK_CHARS=800
